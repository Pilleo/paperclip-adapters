{
  "name": "@pilleo/paperclip-telegram-plugin",
  "version": "0.1.0",
  "description": "Paperclip-idiomatic Telegram companion plugin & operator notification gateway",
  "license": "MIT",
  "type": "module",
  "private": false,
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js"
  },
  "bin": {
    "paperclip-telegram": "./bin/paperclip-telegram.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.2",
    "zod": "^3.24.0"
  },
  "dependencies": {
    "@paperclipai/plugin-sdk": "2026.824.1",
    "zod": "^3.24.0",
    "dotenv": "^16.4.7",
    "@pilleo/paperclip-adapter-common": "workspace:*"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "start": "node bin/paperclip-telegram.js"
  }
}
