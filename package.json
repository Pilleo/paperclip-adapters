{
  "name": "@pilleo/paperclip-adapters-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run build -w @pilleo/paperclip-adapter-common && tsc --noEmit -p packages/orchestrator/tsconfig.json && tsc --noEmit -p packages/jules/tsconfig.json",
    "test:e2e": "tsx packages/orchestrator/scripts/e2e-jules-recovery.ts",
    "release:pack": "tsx scripts/package-release.ts",
    "status": "tsx scripts/status.ts",
    "fleet:tick": "./scripts/fleet/wake_orchestrator.sh",
    "fleet:jules": "./scripts/fleet/wake_jules.sh",
    "fleet:reviewer": "./scripts/fleet/wake_reviewer.sh",
    "fleet:vibe": "./scripts/fleet/wake_vibe.sh",
    "fleet:issues": "./scripts/fleet/list_issues.sh",
    "fleet:approvals": "./scripts/fleet/list_approvals.sh",
    "fleet:agents": "./scripts/fleet/list_agents.sh",
    "fleet:telegram": "./scripts/fleet/run_telegram_companion.sh",
    "fleet:doctor": "./scripts/fleet/doctor.sh",
    "fleet:dashboard": "./scripts/fleet/dashboard.sh",
    "fleet:install": "./scripts/install_all.sh"
  },
  "devDependencies": {
    "@types/node": "22.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
